ORACLE_USER=hopital1
ORACLE_PWD=A_REMPLACER_PAR_UN_MOT_DE_PASSE_LOCAL
ORACLE_DSN=localhost:1521/FREEPDB1

# Generer avec python configurer_jeton.py dans le fichier .env local.
H1_API_TOKEN=
# Connexion du personnel (docs/securite/authentification.md) : valeur dans env.h1.
SEC_SESSION_SECRET=
# Imagerie DICOM (docs/imagerie.md) : PACS Orthanc du CHU, sur la boucle locale.
H1_ORTHANC_URL=http://127.0.0.1:8043/dicom-web
H1_ORTHANC_UTILISATEUR=
H1_ORTHANC_MOT_DE_PASSE=
H1_DICOMWEB_URL=https://127.0.0.1:8000/dicom-web
# Passerelle DICOMweb de la clinique : seule adresse d'ou le CHU telecharge des images.
H2_DICOMWEB_URL=https://ADRESSE_DU_POSTE_H2:8002/dicom-web
# Jeton du client h1-chu (portee h2:imagerie.lire), recu de la clinique hors Git.
H1_JETON_VERS_H2=

# Envoi vers la clinique (client_envoi_h1.py) : adresse de l'API de H2, jeton du client h1-chu (recu hors Git).
H2_BASE_URL=https://ADRESSE_DU_POSTE_H2:8002
# Appels du client d'envoi vers l'API du CHU elle-meme (export du Bundle, etat du consentement).
H1_BASE_URL=https://127.0.0.1:8000
H1_JETON_LOCAL=
# File d'attente des envois : cle AES-256-GCM (docs/securite/chiffrement.md) et chemin SQLite (vide = file_envoi_h1.sqlite3).
H1_CLE_CHIFFREMENT=
H1_FILE_ENVOI=
# Oracle dans Docker (docker-compose.yml) : mot de passe administrateur, local seulement.
ORACLE_ADMIN_PWD=
